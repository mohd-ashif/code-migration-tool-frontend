# Frontend Environment Variables (Vite)
# Note: Vite environment variables MUST start with VITE_ to be exposed to client-side code.

# Backend HTTP API Base URL (e.g. https://code-migration-tool.onrender.com or leave empty for same-domain proxy)
VITE_API_URL=https://code-migration-tool.onrender.com
VITE_API_BASE_URL=https://code-migration-tool.onrender.com

# Backend WebSockets Endpoint (e.g. wss://api.yourdomain.com or leave empty for auto-detection)
VITE_WS_URL=

# Public API Key sent in 'x-api-key' header
VITE_API_KEY=your-api-key-here

# Public Razorpay Gateway Key ID (rzp_test_xxxx or rzp_live_xxxx)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxx
